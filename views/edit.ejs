<!DOCTYPE html>
<html>
<head>
    <title>Edit Food</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="container">

    <div class="form-card">

        <h1>Edit Food</h1>

        <form action="/edit/<%= food.id %>" method="POST">

            <label>Food Name</label>

            <input
                type="text"
                name="name"
                value="<%= food.name %>"
                required
            >

            <label>Category</label>

            <input
                type="text"
                name="category"
                value="<%= food.category %>"
                required
            >

            <label>Price</label>

            <input
                type="number"
                name="price"
                value="<%= food.price %>"
                min="1"
                required
            >

            <label>Availability</label>

            <select name="available">

                <option
                    value="true"
                    <%= food.available ? "selected" : "" %>>
                    Available
                </option>

                <option
                    value="false"
                    <%= !food.available ? "selected" : "" %>>
                    Not Available
                </option>

            </select>

            <button type="submit" class="button">
                Update Food
            </button>

            <a href="/" class="back-button">
                Cancel
            </a>

        </form>

    </div>

</div>

</body>
</html>